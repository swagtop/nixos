new file mode 100644
index 0000000..79e6cd1
--- /dev/null
+++ b/harmonia-cache/src/extra_log.rs
@@ -0,0 +1,17 @@
+use actix_files::NamedFile;
+use actix_web::{HttpResponse, HttpRequest, web};
+use std::error::Error;
+
+use crate::config;
+
+pub(crate) async fn get(config: web::Data<config::Config>, req: HttpRequest) -> Result<HttpResponse, Box<dyn Error>> {
+    match &config.extra_logfile_path {
+        Some(path) => {
+            let file = NamedFile::open(path)?
+                .set_content_type(mime::TEXT_PLAIN_UTF_8);
+
+            Ok(file.into_response(&req))
+        },
+        None => Err("No extra logfile defined in configuration.".into()),
+    }
+}
