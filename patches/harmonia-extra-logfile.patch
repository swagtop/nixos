new file mode 100644
index 0000000..0d9b914
--- /dev/null
+++ b/harmonia-cache/src/extra_log.rs
@@ -0,0 +1,14 @@
+use std::error::Error;
+use std::fs::read_to_string;
+use actix_web::{HttpResponse, web};
+
+use crate::config;
+
+pub(crate) async fn get(
+    config: web::Data<config::Config>,
+) -> Result<HttpResponse, Box<dyn Error>> {
+    match &config.extra_logfile_path {
+        Some(path) => Ok(HttpResponse::Ok().body(read_to_string(path)?)),
+        None => Err("No extra logfile defined in configuration.".into()),
+    }
+}
